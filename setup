
#!/bin/bash

if ! command -v rg >/dev/null 2>&1; then
  if sudo apt-get update; then
    sudo apt-get install -y ripgrep
  else
    echo "Error: Failed to update package index for ripgrep installation" >&2
    exit 1
  fi
fi

curl -fsSL https://claude.ai/install.sh | bash

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cp -r "$DOTFILES_DIR/.claude/." "$HOME/.claude/"

grep -q "^export DOTFILES_DIR=" "$HOME/.bashrc" 2>/dev/null || echo "export DOTFILES_DIR=\"$DOTFILES_DIR\"" >> "$HOME/.bashrc"
